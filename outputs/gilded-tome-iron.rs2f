label: "Minimum quantity"
type: number
group: "E tier"
*/
#define AMMO_E_MIN 1
/*@ define:input:ammo
type: style
label: "Colour"
group: "E tier"
*/
#define AMMO_E_STYLE textColor = "#9e8c2f5b"; textAccent = 1; fontType = 1; menuSort = -10000;
rule (IRONMAN && name:AMMO_A_NAMES && quantity:>=100) { AMMO_SS_STYLE }
rule (IRONMAN && name:AMMO_A_NAMES && quantity:>=10) { AMMO_S_STYLE }
rule (IRONMAN && name:AMMO_A_NAMES && quantity:<AMMO_A_MIN) { hidden = true; }
rule (IRONMAN && name:AMMO_A_NAMES) { AMMO_A_STYLE }
rule (IRONMAN && name:AMMO_B_NAMES && quantity:>=1000) { AMMO_SS_STYLE }
rule (IRONMAN && name:AMMO_B_NAMES && quantity:>=100) { AMMO_S_STYLE }
rule (IRONMAN && name:AMMO_B_NAMES && quantity:>=10) { AMMO_A_STYLE }
rule (IRONMAN && name:AMMO_B_NAMES && quantity:<AMMO_B_MIN) { hidden = true; }
rule (IRONMAN && name:AMMO_B_NAMES) { AMMO_B_STYLE }
rule (IRONMAN && name:AMMO_C_NAMES && quantity:>=10000) { AMMO_SS_STYLE }
rule (IRONMAN && name:AMMO_C_NAMES && quantity:>=1000) { AMMO_S_STYLE }
rule (IRONMAN && name:AMMO_C_NAMES && quantity:>=100) { AMMO_A_STYLE }
rule (IRONMAN && name:AMMO_C_NAMES && quantity:>=10) { AMMO_B_STYLE }
rule (IRONMAN && name:AMMO_C_NAMES && quantity:<AMMO_C_MIN) { hidden = true; }
rule (IRONMAN && name:AMMO_C_NAMES) { AMMO_C_STYLE }
rule (IRONMAN && name:AMMO_D_NAMES && quantity:>=100000) { AMMO_SS_STYLE }
rule (IRONMAN && name:AMMO_D_NAMES && quantity:>=10000) { AMMO_S_STYLE }
rule (IRONMAN && name:AMMO_D_NAMES && quantity:>=1000) { AMMO_A_STYLE }
rule (IRONMAN && name:AMMO_D_NAMES && quantity:>=100) { AMMO_B_STYLE }
rule (IRONMAN && name:AMMO_D_NAMES && quantity:>=10) { AMMO_C_STYLE }
rule (IRONMAN && name:AMMO_D_NAMES && quantity:<AMMO_D_MIN) { hidden = true; }
rule (IRONMAN && name:AMMO_D_NAMES) { AMMO_D_STYLE }
rule (IRONMAN && name:AMMO_E_NAMES && quantity:>=1000000) { AMMO_SS_STYLE }
rule (IRONMAN && name:AMMO_E_NAMES && quantity:>=100000) { AMMO_S_STYLE }
rule (IRONMAN && name:AMMO_E_NAMES && quantity:>=10000) { AMMO_A_STYLE }
rule (IRONMAN && name:AMMO_E_NAMES && quantity:>=1000) { AMMO_B_STYLE }
rule (IRONMAN && name:AMMO_E_NAMES && quantity:>=100) { AMMO_C_STYLE }
rule (IRONMAN && name:AMMO_E_NAMES && quantity:>=10) { AMMO_D_STYLE }
rule (IRONMAN && name:AMMO_E_NAMES && quantity:<AMMO_E_MIN) { hidden = true; }
rule (IRONMAN && name:AMMO_E_NAMES) { AMMO_E_STYLE }

