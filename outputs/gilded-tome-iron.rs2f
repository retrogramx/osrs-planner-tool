label: "Custom B-tier items"
group: "Custom tiers"
*/
#define CUSTOMTIER_B []
rule (IRONMAN && name:CUSTOMTIER_B) { backgroundColor = "#ff27c2ff"; borderColor = "#ff181818"; textColor = "#ff141414"; fontType = 1; textAccent = 3; icon = CurrentItem(); }
/*@ define:input:custom
