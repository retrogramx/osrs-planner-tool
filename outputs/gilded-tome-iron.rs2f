/*@ define:input:custom
type: stringlist
label: "Custom SS-tier items"
group: "Custom tiers"
*/
#define CUSTOMTIER_SS []
rule (IRONMAN && name:CUSTOMTIER_SS) { backgroundColor = "#ffff2b2b"; borderColor = "#ffffffff"; textColor = "#fff5f5f5"; fontType = 3; textAccent = 3; icon = CurrentItem(); sound = 3925; showLootbeam = true; lootbeamColor = "#ffff2b2b"; }
/*@ define:input:custom
type: stringlist
label: "Custom S-tier items"
group: "Custom tiers"
*/
#define CUSTOMTIER_S []
rule (IRONMAN && name:CUSTOMTIER_S) { backgroundColor = "#ffff45d6"; borderColor = "#ff181818"; textColor = "#ff141414"; fontType = 3; textAccent = 3; icon = CurrentItem(); sound = 3925; showLootbeam = true; lootbeamColor = "#ffff45d6"; }
/*@ define:input:custom
type: stringlist
label: "Custom A-tier items"
group: "Custom tiers"
*/
#define CUSTOMTIER_A []
rule (IRONMAN && name:CUSTOMTIER_A) { backgroundColor = "#ffff9a1f"; borderColor = "#ff181818"; textColor = "#ff141414"; fontType = 2; textAccent = 3; icon = CurrentItem(); sound = 3925; }
/*@ define:input:custom
