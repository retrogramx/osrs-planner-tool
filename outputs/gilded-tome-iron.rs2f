*/
#define CUSTOMTIER_C []
rule (IRONMAN && name:CUSTOMTIER_C) { backgroundColor = "#ff52e052"; borderColor = "#ff181818"; textColor = "#ff141414"; fontType = 1; textAccent = 3; icon = CurrentItem(); }
/*@ define:input:custom
type: stringlist
label: "Hide these items"
group: "Hide"
*/
#define CUSTOMHIDE_LIST []
rule (IRONMAN && name:CUSTOMHIDE_LIST) { hidden = true; }

