/*@ define:module:settings
name: "Settings"
subtitle: "Show/hide toggles"
description: |
    Display toggles for spawns, despawn timer, value, and the hide-below-value floor.
*/
#define IRONMAN accountType:1
/*@ define:input:settings
label: Hide below value
type: number
group: Hide
*/
#define HIDE_FLOOR 0
/*@ define:input:settings
label: Show world spawns
type: boolean
group: Show
*/
#define SHOW_WORLD_SPAWNS true
apply (IRONMAN && !SHOW_WORLD_SPAWNS && ownership:0) { hidden = true; }
/*@ define:input:settings
label: Show unowned drops
type: boolean
group: Show
*/
#define SHOW_UNOWNED true
apply (IRONMAN && !SHOW_UNOWNED && ownership:2) { hidden = true; }
/*@ define:input:settings
label: Despawn timer
type: boolean
group: Show
*/
#define SHOW_DESPAWN true
apply (IRONMAN && SHOW_DESPAWN) { showDespawn = true; }
/*@ define:input:settings
label: Item value
type: boolean
group: Show
*/
#define SHOW_VALUE true
apply (IRONMAN && SHOW_VALUE) { showValue = true; }

/*@ define:module:custom
name: "Custom highlights"
subtitle: "Type item names to recolour / hide them yourself"
description: |
    Custom highlights
*/
/*@ define:input:custom
type: stringlist
label: "Custom highlight 1 — items"
group: "Custom highlights"
*/
#define CUSTOMLIST_1 []
/*@ define:input:custom
type: style
label: "Custom highlight 1 — style"
group: "Custom highlights"
*/
